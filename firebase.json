{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "sms-worker/**",
      "**/*.zip",
      "**/*.csv",
      "**/*.ipynb"
    ],
    "headers": [
      {
        "source": "/service-worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions",
    "codebase": "schoolheat",
    "runtime": "nodejs22",
    "ignore": [
      "node_modules",
      ".git",
      "*.log",
      ".env*"
    ]
  }
}
